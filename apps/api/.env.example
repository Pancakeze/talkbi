# Local default uses SQLite. For Docker / production prefer PostgreSQL:
#   postgresql+psycopg://talkbi:talkbi@localhost:5432/talkbi
DATABASE_URL=sqlite+pysqlite:///./talkbi.db

# Production MUST override. JWT signing secret.
SECRET_KEY=talkbi-dev-secret-key

# development | staging | production
ENVIRONMENT=development

# Turn on to log all SQL.
SQL_ECHO=false

# LLM
# - If true, backend uses built-in mock responses and simple staging SELECT.
# - If false, backend will call Ollama to generate SQL (then SQLGuard validates).
LLM_MOCK_MODE=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
